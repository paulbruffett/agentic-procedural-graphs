# Copy to .env and fill in. All LLM calls go through OpenRouter.
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# PG_SOLVER_MODEL=openai/gpt-5.6-luna
# PG_GUIDANCE_MODEL=openai/gpt-5.6-luna
# PG_REFINER_MODEL=anthropic/claude-opus-5
# PG_CONCURRENCY=4

# Optional W&B metrics logging: `uv sync --extra wandb`, then set a project.
# Authenticate with `wandb login` or WANDB_API_KEY; WANDB_ENTITY and WANDB_MODE=offline are honored.
# PG_WANDB_PROJECT=procedural-graphs
